# Unknown --output-format rejected.
#
# An unknown --output-format value is rejected at PreRunE (before any IO)
# with exit 1 and flag.invalid on stderr.

! nesdit does-not-exist.json --output-format xml
stderr '^nesdit: error: flag\.invalid: '
stderr '--output-format: unknown value "xml"'
! stderr 'does-not-exist'
! stderr 'io\.read'
! stdout .
