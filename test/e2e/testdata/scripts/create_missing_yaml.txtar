# --create-missing on YAML.
#
# Parallel of the JSON create-missing case but for YAML format.

# 1. Without --create-missing: setting a nested missing path errors.
! nesdit a.yaml --query '.b.c = 2'
stderr 'query\.missing_path'
! stdout .

# 2. With --create-missing: nested missing path is created.
nesdit a.yaml --create-missing --query '.b.c = 2'
stdout '^a: 1$'
stdout '^b:$'
stdout '^  c: 2$'
! stderr .

# 3. With --create-missing, -i: nested missing path created in-place.
cp a.yaml a_inplace.yaml
nesdit -i a_inplace.yaml --create-missing --query '.b.c = 2'
! stderr .
cmp a_inplace.yaml a_after.yaml

# 4. Without --create-missing: top-level missing key errors.
! nesdit a.yaml --query '.z = 99'
stderr 'query\.missing_path'
! stdout .

# 5. With --create-missing: top-level missing key is created.
nesdit a.yaml --create-missing --query '.z = 99'
stdout '^a: 1$'
stdout '^z: 99$'
! stderr .

-- a.yaml --
a: 1
-- a_after.yaml --
a: 1
b:
  c: 2
