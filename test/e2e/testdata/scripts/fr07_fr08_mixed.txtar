# fr07_fr08_mixed.txtar — FR-7 + FR-8: `--arg` and `--argjson` coexist
# on a single invocation and both bind into the query.
#
# GIVEN `--arg name=alice --argjson count=42`, THEN inside the query
# `$name` is the string "alice" (FR-7 semantics) and `$count` is the
# number 42 (FR-8 semantics). Both appear in the output object in the
# expected shape — proving order-independent binding.

# Note: the object literal in the query uses keys {n, c} that are new
# to the output document — under the positional-reconciliation contract
# (DR-007), brand-new keys lex-sort. Expected order is {c, n}, not the
# order they appear in the query.
nesdit a.json --create-missing --arg name=alice --argjson count=42 --query '.u = {n: $name, c: $count}'
stdout '^{"u":{"c":42,"n":"alice"}}$'

# Reverse flag order — binding must be identical regardless of which
# flag appears first on the command line.
nesdit a.json --create-missing --argjson count=42 --arg name=alice --query '.u = {n: $name, c: $count}'
stdout '^{"u":{"c":42,"n":"alice"}}$'

-- a.json --
{}
