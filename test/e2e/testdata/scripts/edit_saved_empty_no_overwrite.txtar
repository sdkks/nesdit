# Empty-save protection: when the
# user saves an empty file, nesdit MUST NOT overwrite the original, emit
# an error message, and exit 1.
#
# fake-editor writes empty.yaml (zero bytes) over the temp file.

env EDITOR=fake-editor
env FAKE_EDITOR_REPLACE=empty.yaml
env NESDIT_SKIP_TTY_CHECK=1

! nesdit --edit input.yaml
stderr 'empty'

-- input.yaml --
replicas: 3
image: nginx
-- empty.yaml --
