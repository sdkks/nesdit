# smoke.txtar — minimal sanity for the testscript harness and CLI.
#
# Exercises the CLI and custom test commands:
#   - `nesdit --query '.' <file>` runs, writes to stdout
#   - `nesdit-idempotent --query '.' <file>` runs twice, asserts byte-identity
#   - `fake-editor` rewrites a file from a scripted replacement
#
# Separate fixtures cover --edit, --in-place, and multi-file behavior.

# 1. Bare nesdit with empty stdin enters STDIN mode but
# fails format detection on empty input, emitting format.unknown.
! nesdit
stderr '^nesdit: error: format\.'

# 2. Idempotency harness: two runs of the identity query produce identical output.
nesdit-idempotent --query '.' basic.json

# 3. fake-editor: no replacement configured -> target unchanged.
cp before.txt target.txt
fake-editor target.txt
cmp target.txt before.txt

# 4. fake-editor: replacement configured -> target overwritten.
env FAKE_EDITOR_REPLACE=after.txt
fake-editor target.txt
cmp target.txt after.txt

-- basic.json --
{"a":{"b":1,"c":2},"items":[{"x":10},{"x":20}]}
-- before.txt --
original contents
-- after.txt --
edited contents
-- target.txt --
placeholder — cp overwrites before each assertion
