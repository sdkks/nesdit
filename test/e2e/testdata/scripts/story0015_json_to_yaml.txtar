# story0015_json_to_yaml.txtar — STORY-0015: --output-format json→yaml transcoding.
#
# Reading a JSON file and writing YAML output via --output-format yaml.
# Key order is preserved (NFR-3): name appears before version in input,
# so it appears before version in the YAML output.
#
# Note: STDIN stream mode emits a YAML `---` separator before each doc
# (stream writer contract); file→stdout mode uses the single-doc encoder
# which does not prepend `---`.

# STDIN mode: JSON input → YAML output. Stream writer adds `---` prefix.
stdin input.json
nesdit --format json --output-format yaml
stdout '(?s)^---\nname: alice\nversion: 1\n$'
! stderr .

# File mode: JSON file → YAML output to stdout. Single-doc encoder, no `---`.
nesdit input.json --output-format yaml
stdout 'name: alice'
stdout 'version: 1'
! stdout '^---'
! stderr .

-- input.json --
{"name":"alice","version":1}
