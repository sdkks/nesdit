# fr09_dollar_escape.txtar — FR-9: `$${VAR}` in a query emits the literal
# string `${VAR}`. No env interpolation ever.

env FOO=bar_from_env

# `$${FOO}` inside the query's string literal MUST be preserved as the
# literal `${FOO}` — NOT expanded from the environment.
nesdit a.json --create-missing --query '.x = "$${FOO}"'
stdout '^{"x":"\$\{FOO\}"}$'

# Sanity: the shell-env value must NOT appear in stdout.
! stdout 'bar_from_env'

-- a.json --
{}
